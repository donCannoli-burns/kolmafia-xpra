{
	admin off
	auto_https off
}

# Dashboard owns only the landing path and its static/API prefixes. Relay routes keep
# their original root-absolute paths, and the Xpra websocket stays under /xpra/.
:8080 {
	redir /xpra /xpra/
	@landing path /
	redir @landing /dashboard/ 302

	handle_path /dashboard/* {
		root * /opt/kolmafia-dashboard
		file_server
	}
	handle_path /_dashboard/api/* {
		reverse_proxy 127.0.0.1:18081
	}
	handle_path /xpra/* {
		reverse_proxy 127.0.0.1:14500
	}
	handle {
		# The dashboard is not a relay replacement: game.php and all assets still
		# belong to KoLmafia. Phones get the relay's native mobile layout.
		@mobile header_regexp User-Agent (?i)android|iphone|ipod|ipad|mobile
		request_header @mobile Cookie "{http.request.header.Cookie}; mob=1"
		reverse_proxy 127.0.0.1:60080
	}

	handle_errors {
		@relay_down {
			expression {err.status_code} == 502
			not path /xpra /xpra/* /dashboard/* /_dashboard/api/*
		}
		redir @relay_down /xpra/
	}
}
